# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-secure-random-string
APP_DEBUG=true

# Database
DATABASE_URL=sqlite:///./quoryx.db

# Xero OAuth
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=http://localhost:8000/api/auth/xero/callback

# QuickBooks OAuth
QB_CLIENT_ID=your-quickbooks-client-id
QB_CLIENT_SECRET=your-quickbooks-client-secret
QB_REDIRECT_URI=http://localhost:8000/api/auth/quickbooks/callback
QB_ENVIRONMENT=sandbox

# E-conomic (static header tokens, not OAuth2 — both tokens are permanent)
# ECONOMIC_APP_SECRET_TOKEN comes from the e-conomic developer portal (Apps tab).
# ECONOMIC_INSTALLATION_URL is your app's Installation URL the customer is sent to.
# Use "demo" as the secret token to test the wiring against e-conomic's demo agreement.
ECONOMIC_APP_SECRET_TOKEN=your-economic-app-secret-token
ECONOMIC_INSTALLATION_URL=https://secure.e-conomic.com/secure/api1/requestaccess.aspx?appPublicToken=your-app-public-token
ECONOMIC_REDIRECT_URI=http://localhost:8000/api/auth/economic/callback
